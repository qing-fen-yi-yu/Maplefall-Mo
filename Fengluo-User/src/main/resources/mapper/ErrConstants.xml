<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.guilu.mapper.SysMenuMapper">

    <!--
      权限缓存的数据来源：sys_menu.permission 作为网关匹配的路径表达式，
      经 sys_role_menu 关联出允许访问该路径的角色。
      注意：这里用的是 permission 而不是 path —— path 存的是前端路由，permission 才是后端接口表达式。
      因此 permission 里要写 GET:/user/sys-role/list 或 *:/user/sys-role/** 这类可被 AntPathMatcher 匹配的值。

      deleted = 0 必须显式写：MyBatis-Plus 的逻辑删除只作用于 BaseMapper/Wrapper 生成的 SQL，
      手写 XML 不会被自动追加逻辑删除条件。三张表的 deleted 都要判：
      漏掉 rm.deleted = 0 会让「取消角色授权」删除的绑定仍然参与聚合，
      表现为已经摘掉的权限依旧被网关放行。
    -->
    <select id="selectPrivileges" resultType="com.guilu.domain.dto.PrivilegePathRow">
        SELECT m.id         AS menuId,
               m.permission AS permission,
               rm.role_id   AS roleId
        FROM sys_menu m
                 INNER JOIN sys_role_menu rm ON rm.menu_id = m.id AND rm.deleted = 0
                 INNER JOIN sys_role r ON r.id = rm.role_id
        WHERE m.deleted = 0
          AND m.status = 1
          AND r.deleted = 0
          AND r.status = 1
          AND m.permission IS NOT NULL
          AND m.permission != ''
        ORDER BY m.id
    </select>

</mapper>
