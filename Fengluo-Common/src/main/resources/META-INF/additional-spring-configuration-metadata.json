{
  "groups": [
    {
      "name": "fl.mq"
    },
    {
      "name": "fl.redis"
    },
    {
      "name": "fl.mybatis"
    }
  ],
  "properties": [
    {
      "name": "fl.mq.host",
      "type": "java.lang.String",
      "description": "rabbitmq的地址",
      "defaultValue": "192.168.150.104"
    },
    {
      "name": "fl.mq.port",
      "type": "java.lang.Integer",
      "description": "rabbitmq的端口",
      "defaultValue": "5672"
    },
    {
      "name": "fl.mq.vhost",
      "type": "java.lang.String",
      "description": "rabbitmq的virtual-host地址",
      "defaultValue": "/maplefall"
    },
    {
      "name": "fl.mq.username",
      "type": "java.lang.String",
      "description": "rabbitmq的用户名",
      "defaultValue": "guilu"
    },
    {
      "name": "fl.mq.password",
      "type": "java.lang.String",
      "description": "rabbitmq的密码",
      "defaultValue": "123"
    },
    {
      "name": "fl.mq.listener.retry.enable",
      "type": "java.lang.Boolean",
      "description": "是否开启rabbitmq的消费者重试机制",
      "defaultValue": "true"
    },
    {
      "name": "fl.mq.listener.retry.interval",
      "type": "java.time.Duration",
      "description": "消费者重试初始失败等待时长",
      "defaultValue": "1000ms"
    },
    {
      "name": "fl.mq.listener.retry.multiplier",
      "type": "java.lang.Integer",
      "description": "失败等待时长的递增倍数",
      "defaultValue": "1"
    },
    {
      "name": "fl.mq.listener.retry.max-attempts",
      "type": "java.lang.Integer",
      "description": "消费者重试最大重试次数",
      "defaultValue": "3"
    },
    {
      "name": "fl.mq.listener.retry.stateless",
      "type": "java.lang.Boolean",
      "description": "是否是无状态，默认true",
      "defaultValue": "true"
    },
    {
      "name": "fl.redis.host",
      "type": "java.lang.String",
      "description": "redis的地址",
      "defaultValue": "192.168.150.101"
    },
    {
      "name": "fl.redis.password",
      "type": "java.lang.String",
      "description": "redis的密码",
      "defaultValue": "123321"
    },
    {
      "name": "fl.redis.pool.max-active",
      "type": "java.lang.Integer",
      "description": "redis的连接池最大连接数",
      "defaultValue": "8"
    },
    {
      "name": "fl.redis.pool.max-idle",
      "type": "java.lang.Integer",
      "description": "redis的最大空闲连接",
      "defaultValue": "8"
    },
    {
      "name": "fl.redis.pool.min-idle",
      "type": "java.lang.Integer",
      "description": "redis的最小空闲连接",
      "defaultValue": "1"
    },
    {
      "name": "fl.redis.pool.max-wait",
      "type": "java.lang.Integer",
      "description": "无连接时最大空闲等待时间",
      "defaultValue": "300"
    },
    {
      "name": "fl.mysql.host",
      "type": "java.lang.String",
      "description": "数据库地址",
      "defaultValue": "192.168.150.104"
    },
    {
      "name": "fl.mysql.port",
      "type": "java.lang.Integer",
      "description": "数据库端口",
      "defaultValue": "3306"
    },
    {
      "name": "fl.mysql.database",
      "type": "java.lang.String",
      "description": "数据库database名",
      "defaultValue": ""
    },
    {
      "name": "fl.mysql.username",
      "type": "java.lang.String",
      "description": "数据库用户名",
      "defaultValue": "root"
    },
    {
      "name": "fl.mysql.password",
      "type": "java.lang.String",
      "description": "数据库密码",
      "defaultValue": "123456"
    },
    {
      "name": "fl.mysql.driver-class-name",
      "type": "java.lang.String",
      "description": "数据库驱动",
      "defaultValue": "com.mysql.cj.jdbc.Driver"
    }
  ],
  "hints": []
}